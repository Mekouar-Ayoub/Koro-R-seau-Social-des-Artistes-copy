# Configuration .env pour Kore Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Kore
VITE_APP_VERSION=1.0.0

# Configuration des cartes (optionnel)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Services externes (optionnel)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Configuration de l'application
VITE_DEFAULT_LATITUDE=33.5731
VITE_DEFAULT_LONGITUDE=-7.5898
VITE_DEFAULT_ZOOM=10

# Limites de fichiers
VITE_MAX_FILE_SIZE_MB=10
VITE_SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,flac

# Configuration de développement
VITE_DEV_MODE=true
VITE_BACKEND_URL=http://localhost:8000